# Copy file này thành tools/deploy-hosting.env rồi điền thông tin THẬT.
# File .env đã nằm trong .gitignore — KHÔNG BAO GIỜ commit mật khẩu hosting.

# ssh | ftp | zip
VHCP_METHOD=zip

# Thư mục plugins trên hosting (không có dấu / ở cuối)
#   cPanel/Hostinger thường là: /home/<user>/public_html/wp-content/plugins
VHCP_REMOTE_PLUGINS_DIR=/home/USER/public_html/wp-content/plugins

# ---- khi VHCP_METHOD=ssh ----
VHCP_SSH_HOST=
VHCP_SSH_USER=
VHCP_SSH_PORT=22
# Đường dẫn gốc WordPress trên hosting, để thử kích hoạt bằng wp-cli (bỏ trống thì kích hoạt tay)
VHCP_WP_PATH=

# ---- khi VHCP_METHOD=ftp ----
VHCP_FTP_HOST=
VHCP_FTP_USER=
VHCP_FTP_PASS=
VHCP_FTP_PROTO=ftps
VHCP_FTP_SSL_FORCE=true
VHCP_FTP_VERIFY=true
