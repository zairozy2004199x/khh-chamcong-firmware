# === Rác hệ điều hành ===
Thumbs.db
ehthumbs.db
desktop.ini
.DS_Store

# === Trình soạn thảo / IDE ===
.vscode/
*.swp
*~
*.tmp

# === Bí mật ===
.env
*.key
secrets.*
# .gitignore KHÔNG hỗ trợ comment cuối dòng — phải để riêng dòng như này.
# File MẪU (chỉ placeholder) PHẢI được commit, không thì pull về không có khuôn để copy:
!secrets.example.h
# secrets.ci.h chỉ chứa "__CHUA_CAU_HINH__" cho GitHub Actions build.
# PHẢI commit, không thì workflow đỏ ngay bước cp (đã bị một lần ở repo nội bộ).
!secrets.ci.h

# token.txt là thẻ SD mang token/mật khẩu THẬT đi nạp máy chấm công.
# Repo này CÔNG KHAI — lọt vào một lần là lộ vĩnh viễn trong lịch sử git.
token.txt
# Bản MẪU toàn placeholder thì phải commit, để pull về có khuôn mà copy:
!token.txt.mau

# Bản build Arduino: rác 42MB, và .bin/.elf/.map chứa bí mật ở dạng chữ đọc được.
esp32_*/build/
*/build/esp32.esp32.esp32/

# Thông tin đăng nhập hosting để đẩy plugin — KHÔNG commit.
tools/deploy-hosting.env

# Bản đóng gói để cài lên hosting — sinh lại bằng `bash tools/build-plugin-zip.sh` bất cứ lúc nào.
# Không commit: nó là sản phẩm build, mà commit .zip thì mỗi lần đóng gói lại là một bản nhị phân
# mới trong lịch sử git, phình repo mà không đọc diff được.
dist/
