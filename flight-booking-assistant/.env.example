# Chép file này thành .env (cùng thư mục) rồi sửa các dòng dưới.
# Cả proxy giá lẫn máy chủ đơn hàng đều tự đọc file .env này — không phải gõ biến môi trường.

# ---- Giá thật (bỏ trống thì bảng giá chạy bằng giá mô phỏng) ----
AMADEUS_ID=
AMADEUS_SECRET=
AMADEUS_ENV=test

# ---- Tài khoản nhận tiền của khách ----
BANK_ID=970436
BANK_ACCOUNT=0071000123456
BANK_NAME=CONG TY TNHH K&H
BANK_LABEL=Vietcombank

# ---- Khoá ----
# ADMIN_TOKEN: mật khẩu vào trang quản trị. Bỏ trống thì máy tự sinh và in ra lúc khởi động.
# WEBHOOK_SECRET: khoá cho dịch vụ báo biến động số dư (SePay, Casso…). Bỏ trống thì tiền về phải bấm tay.
ADMIN_TOKEN=
WEBHOOK_SECRET=

# ---- Cách tính tiền ----
FEE_PCT=3
FEE_FLAT=0
FEE_MIN=50000
HOLD_MINUTES=30

# ---- Cổng ----
PORT=8788
